# ==============================================================================
# A.S. BLOGS PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development.
# Configure these variables in Vercel Project Settings -> Environment Variables.
# NEVER commit real secret values to version control.
# ==============================================================================

# Database Connection String (PostgreSQL: Neon or Supabase)
# Free hosted database from https://neon.tech or https://supabase.com
# Example Neon: DATABASE_URL="postgresql://neondb_owner:npg_xxxx@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Example Supabase: DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.xxxx.supabase.co:5432/postgres"
DATABASE_URL="postgresql://username:password@ep-host.region.aws.neon.tech/neondb?sslmode=require"

# Canonical Production URL (Without trailing slash)
# e.g., "https://as-blogs.vercel.app" or your custom domain "https://asbrandoils.com"
NEXT_PUBLIC_SITE_URL="https://as-blogs.vercel.app"

# Site Branding & Metadata
NEXT_PUBLIC_SITE_NAME="A.S. Heritage & Living | Indian Culinary, Wellness & Culture"

# Cryptographic Session JWT Secret
# Generate a 64-character random string (e.g. `openssl rand -base64 48`)
JWT_SECRET=""

# Default Administrator Password (Used for initial login)
ADMIN_PASSWORD=""

# ==============================================================================
# IMAGE STORAGE CONFIGURATION (Choose either Option A or Option B)
# ==============================================================================
# Option A: Cloudinary (100% Free Tier - https://cloudinary.com)
# Option 1 (Single URL format):
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"
# OR Option 2 (Individual keys):
# CLOUDINARY_CLOUD_NAME="your_cloud_name"
# CLOUDINARY_API_KEY="your_api_key"
# CLOUDINARY_API_SECRET="your_api_secret"

# Option B: Vercel Blob (1-click integration in Vercel Storage Tab)
# Automatically populated by Vercel when you add a Blob store
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_xxxxxx"

